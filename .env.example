# Skopiuj ten plik do .env i uzupełnij wartościami ze swojego projektu Supabase.

# Supabase → Project Settings → Database → Connection string
# "Transaction" pooler (port 6543) — używane przez aplikację w czasie działania.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# "Session"/direct connection (port 5432) — używane tylko przy migracjach.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://xxxxx.supabase.co"
# "service_role" key (NIE "anon" key) — ma pełny dostęp, trzymaj wyłącznie po stronie serwera.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# "anon" / "public" key — bezpieczna do ujawnienia w przeglądarce (chroniona przez RLS).
# Używana do wysyłania dużych plików PDF bezpośrednio z przeglądarki do Supabase Storage,
# z pominięciem limitu 4.5MB na request funkcji serverless Vercela.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Nazwa bucketa Storage utworzonego w Supabase (Storage → New bucket).
SUPABASE_STORAGE_BUCKET="library"
